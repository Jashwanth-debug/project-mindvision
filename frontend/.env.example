# MindVision Clinical AI - Frontend Production Environment Variables Template
# Copy to .env.production or set in hosting platform dashboard (e.g. Vercel)

# Target Backend API URL
# Leave blank to use relative /api/ proxy rewrites on the same domain or Vercel rewrites
# Or set to your public Render/Railway backend URL:
VITE_API_BASE_URL=https://mindvision-clinical-backend.onrender.com
