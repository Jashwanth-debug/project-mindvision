{
  "name": "mindvision-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); try{fs.cpSync('dist','../dist',{recursive:true});}catch{}\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:start": "cd .. && npm run desktop:start",
    "desktop:build": "npm run build",
    "desktop:package": "cd .. && npm run desktop:package"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
