# MindVision Clinical AI - Backend Production Environment Variables Template
# Copy to .env in production deployment dashboard or server

# Node Environment
NODE_ENV=production
PORT=5001

# Authentication & Security
# Generate a strong 64-character random string for JWT_SECRET
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
ADMIN_PASSWORD=replace_with_strong_admin_passphrase_2026!
DOCTOR_DEFAULT_PASSWORD=replace_with_clinician_portal_default_password_2026!

# Optional Cloud Neural Text-To-Speech Providers
# Leave blank to use 100% on-device browser speech synthesis fallback
TTS_PROVIDER=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1-hd
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=
